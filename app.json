{
  "expo": {
    "name": "Inbox.GOP",
    "slug": "inbox-gop-ios",
    "version": "1.0.0",
    "platforms": ["ios"],
    "orientation": "portrait",
    "icon": "./assets/images/inbox-gop-app-icon.png",
    "scheme": "inboxgop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.inboxgop.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/inbox-gop-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F9",
          "dark": {
            "backgroundColor": "#0B1720"
          },
          "image": "./assets/images/inbox-gop-mark.png",
          "imageWidth": 116
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
